{
  "schema": 1,
  "id": "openhop.meshzork",
  "name": "MeshZork",
  "version": "0.1.1",
  "description": "A small multi-player interactive-fiction game reached by MeshCore direct messages.",
  "runtime": {
    "type": "python",
    "entrypoint": "meshzork-openhop"
  },
  "config": {
    "defaults": {
      "meshcore_host": "127.0.0.1",
      "meshcore_port": 5002,
      "max_reply_bytes": 145,
      "max_command_bytes": 160,
      "duplicate_ttl_seconds": 600,
      "log_level": "INFO"
    }
  }
}
