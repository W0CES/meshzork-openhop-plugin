{
  "schema": 1,
  "id": "openhop.meshzork",
  "name": "MeshZork",
  "version": "0.3.1",
  "description": "Play the MIT-licensed historical Zork I release through MeshCore direct messages.",
  "runtime": {
    "type": "python",
    "entrypoint": "meshzork-openhop"
  },
  "ui": {
    "type": "application",
    "entry": "ui/index.html"
  },
  "config": {
    "defaults": {
      "meshcore_host": "127.0.0.1",
      "meshcore_port": 5002,
      "max_reply_bytes": 145,
      "max_command_bytes": 160,
      "duplicate_ttl_seconds": 600,
      "auto_page_limit": 4,
      "page_delay_seconds": 2.0,
      "max_active_players": 3,
      "active_player_timeout_seconds": 900,
      "busy_notice_ttl_seconds": 300,
      "save_retention_days": 30,
      "story_path": "",
      "random_seed": 117,
      "log_level": "INFO"
    }
  }
}
